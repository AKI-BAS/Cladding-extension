<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cladding" Width="980" Height="600" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#E6E8EB"
        FontFamily="Segoe UI" FontSize="12" Foreground="#16181B">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#16181B"/>
        <SolidColorBrush x:Key="Muted" Color="#8A9097"/>
        <SolidColorBrush x:Key="Line" Color="#C9CDD2"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Width" Value="90"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16181B"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6D9DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dark" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#16181B" CornerRadius="14" Padding="18,11">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- Left: profile library -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="0,0,0,6" Text="Profiles"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="ProfileInfo" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="on_change"/>
        </DockPanel>

        <!-- Centre: preview -->
        <Grid Grid.Column="1" Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Canvas x:Name="PreviewCanvas" ClipToBounds="True" SizeChanged="on_change"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Text="Rotation" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="AngleText" FontSize="26" HorizontalAlignment="Center" Text="35°"/>
                <Slider x:Name="AngleSlider" Width="220" Minimum="-80" Maximum="80" Value="35"
                        ValueChanged="on_change"/>
            </StackPanel>
        </Grid>

        <!-- Right: panel settings -->
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,6" Text="Panel"/>
                <DockPanel Margin="0,4"><TextBlock Text="Cover width (mm)"/>
                    <TextBox x:Name="WidthBox" HorizontalAlignment="Right" Text="1000" TextChanged="on_change"/></DockPanel>
                <DockPanel Margin="0,4"><TextBlock Text="Max length (mm)"/>
                    <TextBox x:Name="LengthBox" HorizontalAlignment="Right" Text="6000" TextChanged="on_change"/></DockPanel>
                <DockPanel Margin="0,4"><TextBlock Text="Joint (mm)"/>
                    <TextBox x:Name="JointBox" HorizontalAlignment="Right" Text="10" TextChanged="on_change"/></DockPanel>
                <DockPanel Margin="0,4"><TextBlock Text="Standoff (mm)"/>
                    <TextBox x:Name="StandoffBox" HorizontalAlignment="Right" Text="30" TextChanged="on_change"/></DockPanel>
                <TextBlock Style="{StaticResource Label}" Text="Orientation"/>
                <ComboBox x:Name="OrientationBox" SelectedIndex="0" SelectionChanged="on_change">
                    <ComboBoxItem Content="Vertical ribs"/>
                    <ComboBoxItem Content="Horizontal ribs"/>
                </ComboBox>
                <TextBlock Style="{StaticResource Label}" Text="Material"/>
                <ComboBox x:Name="MaterialBox"/>
                <TextBlock Style="{StaticResource Label}" Text="Quantities (estimate, picked faces)"/>
                <TextBlock x:Name="QtyText" FontFamily="Consolas" LineHeight="18"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                <TextBlock x:Name="StatusText" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button x:Name="ApplyButton" Style="{StaticResource Dark}" Content="Apply to faces" Click="apply_click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
